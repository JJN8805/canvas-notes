<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/cnw_background" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/cnw_page_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:gravity="center_vertical" android:textColor="@color/cnw_ink" android:textSize="16sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/cnw_change" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center" android:text="⚙" android:textColor="@color/cnw_soft" android:textSize="18sp" android:contentDescription="@string/widget_change" />
    </LinearLayout>
    <TextView android:id="@+id/cnw_page_text" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textColor="@color/cnw_ink" android:textSize="14sp" android:ellipsize="end" android:maxLines="40" />
</LinearLayout>

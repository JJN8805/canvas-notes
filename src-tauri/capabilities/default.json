{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "What the Canvas Notes window may do: its own database, files in its own folder, and files you pick in a save dialog.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "sql:default",
    "sql:allow-execute",
    "fs:allow-appconfig-read-recursive",
    "fs:allow-appconfig-write-recursive",
    "dialog:allow-save"
  ]
}
